# Salin menjadi .env lalu isi nilainya. Jangan commit berkas .env.
# Secret tidak boleh masuk repository (R-01-03, PRD §9.2).

# Wajib. Aplikasi menolak start bila kosong (R-01-04).
SECRET_KEY=ganti-dengan-string-acak-panjang

# --- Akses data aplikasi (PostgREST) ---------------------------------------
# Wajib. Dipakai aplikasi web untuk membaca dan menulis baris.
# Dashboard Supabase: Settings -> API Keys -> "publishable" key (sb_publishable_...).
# Kunci lama "anon" (eyJ...) juga berfungsi.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Koneksi database langsung (migrasi) -----------------------------------
# Wajib hanya untuk `python -m db migrate` dan `python -m db status`.
# Ini koneksi Postgres, bukan PostgREST, sehingga DDL bisa dijalankan dari program.
# Dashboard Supabase: Settings -> Database -> Connection string.
# Gunakan "Session pooler" (port 5432) agar cocok untuk migrasi.
#
#   SUPABASE_DB_HOST     = aws-0-<region>.pooler.supabase.com
#   SUPABASE_DB_USER     = postgres.<project-ref>
#   SUPABASE_DB_PASSWORD = password database yang dibuat saat membuat project
#
# Jangan tertukar: SUPABASE_KEY memakai kunci API, SUPABASE_DB_PASSWORD memakai
# password database. Keduanya berbeda dan tidak dapat saling menggantikan.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=require

# AI. Kosongkan bila fitur asisten tidak dipakai saat pengembangan.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
AI_DAILY_LIMIT=20

# Pipeline data.
SCRAPER_USER_AGENT=KarirLensBot/1.0 (agregator lowongan)
SCRAPER_MAX_RETRY=3

# Clustering.
CLUSTER_N_CLUSTERS=6
CLUSTER_PCA_COMPONENTS=2

# Unggah CV, dalam byte. Bawaan 5 MB (PRD §14.1).
MAX_UPLOAD_BYTES=5242880

# Set true hanya pada environment produksi (cookie Secure).
SESSION_COOKIE_SECURE=false

# Aktifkan blueprint preview (Track A) untuk meninjau UI dengan data contoh.
# Jangan diaktifkan pada produksi.
PREVIEW_UI=false
